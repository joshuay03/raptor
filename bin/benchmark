#!/usr/bin/env ruby

# frozen_string_literal: true

require "optparse"

options = { fast: false, update_readme: false }
OptionParser.new do |opts|
  opts.banner = "Usage: bin/benchmark [options]"
  opts.on("--fast", "Use short warmup/measurement windows for quick iteration") do
    options[:fast] = true
  end
  opts.on("--filter PATTERN", Regexp, "Run cases whose labels match PATTERN") do |pattern|
    options[:filter] = pattern
  end
  opts.on("--list", "List selected cases and the timed workload budget without running them") do
    options[:list] = true
  end
  opts.on("--output PATH.json", "Save metadata and samples (default: tmp/benchmark[-fast|-filtered].json)") do |path|
    options[:output] = path
  end
  opts.on("--update-servers", "Update Puma and Falcon before benchmarking; otherwise use the bundle as locked") do
    options[:update_servers] = true
  end
  opts.on("--update-readme", "Replace the README's (Micro) Benchmarks section with the results") do
    options[:update_readme] = true
  end
end.parse(ARGV)

abort "--update-readme requires a full run without --fast or --filter" if options[:update_readme] && (options[:fast] || options[:filter])
suffix = if options[:fast]
  "-fast"
elsif options[:filter]
  "-filtered"
end
options[:output] ||= "tmp/benchmark#{suffix}.json"
abort "--output must end in .json" unless File.extname(options[:output]) == ".json"

unless File.exist?("/.dockerenv")
  exec(File.expand_path("dev", __dir__), "bin/#{File.basename(__FILE__)}", *ARGV)
end

system("bundle", "update", "puma", "falcon", exception: true) if options[:update_servers]
system("bundle", "install", exception: true) unless options[:update_servers]

require "bundler/setup"

require "etc"
require "fileutils"
require "json"
require "open3"
require "openssl"
require "socket"
require "tempfile"
require "time"
require "timeout"

require "concurrent/utility/processor_counter"

require_relative "../lib/raptor/version"

WORKERS = Integer(Concurrent.available_processor_count).clamp(1, 10)
BASE_THREADS = 3
MAX_SCALING_THREADS = 16
CLIENTS_PER_SERVER_THREAD = 4
HEY_CONNECTIONS = WORKERS * BASE_THREADS * CLIENTS_PER_SERVER_THREAD
H2LOAD_STREAMS = 3
H2LOAD_CONNECTIONS = HEY_CONNECTIONS / H2LOAD_STREAMS
MAX_KEEPALIVE_REQUESTS = 999
SSE_STREAMS_PER_WORKER = 2
SSE_STREAMS = WORKERS * SSE_STREAMS_PER_WORKER
SSE_OPEN_TIMEOUT_SECONDS = 2
CLOCK_TICKS = Etc.sysconf(Etc::SC_CLK_TCK)
ORDER_SEED = 0
H1_PORT = 9292
H2_PORT = 9443
CERT_PATH = "tmp/bench.crt"
KEY_PATH = "tmp/bench.key"
POST_BODY_PATH = "tmp/bench-body.json"
README_PATH = File.expand_path("../README.md", __dir__)
BENCHMARKS_SECTION_PATTERN = /## \(Micro\) Benchmarks.*?(?=\n## |\z)/m

POST_BODY = JSON.generate(
  user_id: 42,
  session_token: "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxMjM0NTY3ODkwIiwibmFtZSI6IkpvaG4gRG9lIn0",
  filters: { status: "active", tags: ["premium", "verified"], created_after: "2024-01-01" },
  pagination: { page: 1, per_page: 50, sort: "created_at", direction: "desc" },
  trace_id: "abc123def456ghi789jkl012mno345pqr678"
)

# The development image builds hey without its one-million-response storage cap.
HEY_REPORT = <<~TEMPLATE.freeze
  Total: {{ .Total.Seconds }} secs
  Requests: {{ .NumRes }}
  Latency samples: {{ len .Lats }}
  Requests/sec: {{ .Rps }}
  Total data: {{ .SizeTotal }} bytes

  Latency distribution:{{ range .LatencyDistribution }}
    {{ .Percentage }}% in {{ .Latency }} secs{{ end }}

  Status code distribution:{{ range $code, $num := .StatusCodeDist }}
    [{{ $code }}] {{ $num }} responses{{ end }}

  Error distribution:{{ range $err, $num := .ErrorDist }}
    [{{ $num }}] {{ $err }}{{ end }}
TEMPLATE

WORKLOADS = {
  io: { label: "IO", fixture: "test/fixtures/io_bound.ru", method: :get },
  cpu: { label: "CPU", fixture: "test/fixtures/cpu_bound.ru", method: :post },
  body: { label: "64 KiB body", fixture: "test/fixtures/large_body.ru", method: :get },
  sse: { label: "IO + SSE (native)", fixture: "test/fixtures/sse.ru", method: :get },
  sse_enumerator: { label: "IO + SSE (Enumerator)", fixture: "test/fixtures/sse.ru", method: :get }
}.freeze

MODES = {
  fixed: { label: "Fixed (3)", threads: BASE_THREADS, max_threads: BASE_THREADS },
  scaling: { label: "Scaling (3–16)", threads: BASE_THREADS, max_threads: MAX_SCALING_THREADS },
  fixed16: { label: "Fixed (16)", threads: MAX_SCALING_THREADS, max_threads: MAX_SCALING_THREADS },
  fibers: { label: "Fibers", threads: nil, max_threads: nil }
}.freeze

PROTOCOLS = { h1: "HTTP/1.1", h1_ka: "HTTP/1.1 keep-alive", h2: "HTTP/2" }.freeze

if options[:fast]
  RUNS_PER_MODE = 1
  WARMUP_SECONDS = 2
  MAIN_SECONDS = 5
else
  RUNS_PER_MODE = 3
  WARMUP_SECONDS = 3
  MAIN_SECONDS = 15
end

def require_tool(name)
  return if system("which #{name} > /dev/null 2>&1")

  abort "Missing required tool: #{name.inspect}. Run bin/setup."
end

def log(message)
  warn "[bench] #{message}"
end

def generate_cert
  FileUtils.mkdir_p(File.dirname(CERT_PATH))
  cmd = [
    "openssl", "req", "-x509", "-newkey", "rsa:2048",
    "-keyout", KEY_PATH, "-out", CERT_PATH,
    "-days", "365", "-nodes",
    "-subj", "/CN=localhost",
    "-addext", "subjectAltName=DNS:localhost,IP:127.0.0.1"
  ]
  return if system(*cmd, out: File::NULL, err: File::NULL)

  abort "Failed to generate TLS cert/key."
end

def write_post_body
  FileUtils.mkdir_p(File.dirname(POST_BODY_PATH))
  File.write(POST_BODY_PATH, POST_BODY)
end

def wait_for_port(port, timeout: 30)
  deadline = Time.now + timeout
  loop do
    begin
      probe_port(port)
      return
    rescue Errno::ECONNREFUSED, Errno::ECONNRESET, Errno::ETIMEDOUT, EOFError, IOError, OpenSSL::SSL::SSLError, Timeout::Error
      raise "Port #{port} never opened" if Time.now > deadline

      sleep 0.2
    end
  end
end

def probe_port(port)
  if port == H2_PORT
    tcp = TCPSocket.new("127.0.0.1", port)
    context = OpenSSL::SSL::SSLContext.new
    context.verify_mode = OpenSSL::SSL::VERIFY_NONE
    ssl = OpenSSL::SSL::SSLSocket.new(tcp, context)
    ssl.sync_close = true
    begin
      Timeout.timeout(1) { ssl.connect }
    ensure
      ssl.close
    end
  else
    socket = TCPSocket.new("127.0.0.1", port)
    begin
      socket.write("GET / HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n")
      Timeout.timeout(1) { socket.readpartial(1) }
    ensure
      socket.close
    end
  end
end

def wait_for_port_free(port, timeout: 30)
  deadline = Time.now + timeout
  loop do
    begin
      Socket.tcp("127.0.0.1", port, connect_timeout: 1).close
      raise "Port #{port} still in use" if Time.now > deadline

      sleep 0.5
    rescue Errno::ECONNREFUSED, Errno::ECONNRESET
      return
    rescue Errno::ETIMEDOUT, IO::TimeoutError
      raise "Port #{port} did not become available" if Time.now > deadline

      sleep 0.5
    end
  end
end

SPAWNED_SERVERS = []

def descendants_of(pid)
  discovered = []
  frontier = [pid]
  until frontier.empty?
    parent = frontier.shift
    children = `pgrep -P #{parent}`.split.map(&:to_i)
    discovered.concat(children)
    frontier.concat(children)
  end
  discovered
end

def kill_process_tree(pid, signal)
  targets = descendants_of(pid).reverse + [pid]
  targets.each do |target|
    Process.kill(signal, target) rescue nil
    Process.kill(signal, -target) rescue nil
  end
end

def reap_all_spawned_servers
  SPAWNED_SERVERS.each do |pid|
    kill_process_tree(pid, "KILL")
    Process.wait(pid) rescue nil
  end
  SPAWNED_SERVERS.clear
end

at_exit { reap_all_spawned_servers }

%w[INT TERM].each do |signal|
  trap(signal) { exit(1) }
end

def start_server(cmd, ports)
  ports.each { |port| wait_for_port_free(port, timeout: 0) }
  log_file = Tempfile.new(["server-", ".log"])
  pid = Thread.handle_interrupt(SystemExit => :never) do
    child_pid = spawn(*cmd, [:out, :err] => log_file.path, pgroup: true)
    SPAWNED_SERVERS << child_pid
    child_pid
  end
  ports.each { |port| wait_for_port(port) }
  [pid, log_file]
rescue => error
  kill_process_tree(pid, "TERM") if pid
  SPAWNED_SERVERS.delete(pid) if pid
  warn File.read(log_file.path)
  log_file.close!
  raise error
end

def stop_server(pid, ports, log_file)
  kill_process_tree(pid, "TERM")
  begin
    Timeout.timeout(5) { Process.wait(pid) }
  rescue Timeout::Error
    kill_process_tree(pid, "KILL")
    Process.wait(pid) rescue nil
  rescue Errno::ESRCH, Errno::ECHILD
  end
  kill_process_tree(pid, "KILL")
  begin
    loop { break unless Process.wait(-1, Process::WNOHANG) }
  rescue Errno::ECHILD
  end
  SPAWNED_SERVERS.delete(pid)
  ports.each { |port| wait_for_port_free(port) }
  log_file.close!
end

def with_server(label, cmd, ports)
  log "Starting #{label}"
  pid, log_file = start_server(cmd, ports)
  yield pid
rescue Exception => error
  warn "===== #{label} server log ====="
  warn File.read(log_file.path) if pid
  warn "===== end server log ====="
  raise error
ensure
  log "Stopping #{label}"
  stop_server(pid, ports, log_file) if pid
end

def process_usage(pids)
  pids.to_h do |pid|
    # The command name is parenthesized and may itself contain spaces or ')'.
    fields = File.read("/proc/#{pid}/stat").rpartition(") ").last.split
    pss = File.foreach("/proc/#{pid}/smaps_rollup").find { |line| line.start_with?("Pss:") }
    [pid, { cpu_ticks: fields[11].to_i + fields[12].to_i, pss_bytes: pss.split[1].to_i * 1024 }]
  end
end

def measure_server(pid)
  pids = [pid, *descendants_of(pid)].sort
  before = process_usage(pids)
  peak_pss_bytes = before.values.sum { |usage| usage[:pss_bytes] }
  started_at = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  sampler = Thread.new do
    loop do
      sleep 0.5
      pss_bytes = process_usage(pids).values.sum { |usage| usage[:pss_bytes] }
      peak_pss_bytes = [peak_pss_bytes, pss_bytes].max
    end
  end

  result = yield
  sampler.kill
  sampler.value
  after = process_usage(pids)
  elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started_at
  raise "Server process tree changed during measurement" unless pids == [pid, *descendants_of(pid)].sort

  processes = pids.map do |process_pid|
    {
      pid: process_pid,
      cpu_seconds: (after.fetch(process_pid)[:cpu_ticks] - before.fetch(process_pid)[:cpu_ticks]).fdiv(CLOCK_TICKS)
    }
  end
  usage = {
    elapsed_seconds: elapsed,
    cpu_seconds: processes.sum { |process| process[:cpu_seconds] },
    peak_pss_bytes: [peak_pss_bytes, after.values.sum { |process| process[:pss_bytes] }].max,
    processes: processes
  }
  [result, usage]
ensure
  sampler&.kill
  sampler&.value
end

def run_hey(pid, url:, keep_alive:, method:, allow_timeouts: false)
  keep_alive_flag = keep_alive ? nil : "-disable-keepalive"
  method_args = method == :post ? ["-m", "POST", "-T", "application/json", "-D", POST_BODY_PATH] : []
  warmup = ["hey", "-o", HEY_REPORT, "-c", HEY_CONNECTIONS.to_s, "-z", "#{WARMUP_SECONDS}s", keep_alive_flag, *method_args, url].compact
  warmup_output, warmup_status = Open3.capture2(*warmup)
  abort_with_output "hey warmup failed", warmup_output unless warmup_status.success?
  check_hey_clean(warmup_output, "warmup", allow_timeouts: allow_timeouts)

  measure = ["hey", "-o", HEY_REPORT, "-c", HEY_CONNECTIONS.to_s, "-z", "#{MAIN_SECONDS}s", keep_alive_flag, *method_args, url].compact
  (output, status), usage = measure_server(pid) { Open3.capture2(*measure) }
  abort_with_output "hey failed", output unless status.success?
  timeouts = check_hey_clean(output, "measurement", allow_timeouts: allow_timeouts)

  total_match = output.match(/Total:\s+([\d.]+) secs/)
  abort_with_output "Could not parse hey duration", output unless total_match
  requests_match = output.match(/^Requests:\s+(\d+)$/)
  abort_with_output "Could not parse hey request count", output unless requests_match
  completed = requests_match[1].to_i - timeouts

  latency_samples = output.match(/^Latency samples:\s+(\d+)$/)
  abort_with_output "hey did not retain every successful response; rebuild with docker build -t raptor-dev:latest .", output unless latency_samples && latency_samples[1].to_i == completed

  p95_match = output.match(/95%+\s+in\s+([\d.]+)/)
  abort_with_output "Could not parse hey p95", output unless p95_match

  {
    req_s: completed / total_match[1].to_f,
    completed: completed,
    latency_samples: latency_samples[1].to_i,
    p95_ms: p95_match[1].to_f * 1000,
    timeouts: timeouts,
    cpu_ms_per_request: usage[:cpu_seconds] * 1000 / completed,
    usage: usage,
    warmup_command: warmup,
    measurement_command: measure,
    output: output
  }
end

# Aborts on errors and non-2xx responses, except client timeouts when
# `allow_timeouts` is set, and returns the number of timed out requests.
def check_hey_clean(output, phase, allow_timeouts: false)
  errors = output.partition("Error distribution:").last.scan(/\[(\d+)\]\s+(.*)/)
  timeouts = errors.sum { |count, message| message.include?("Client.Timeout exceeded") ? count.to_i : 0 }
  other_errors = errors.sum { |count, _message| count.to_i } - timeouts
  abort_with_output "hey #{phase} produced errors", output if other_errors.positive? || (timeouts.positive? && !allow_timeouts)

  responses = output.scan(/\[(\d{3})\]\s+\d+ responses/).flatten
  abort_with_output "hey #{phase} received no responses", output if responses.empty?

  non_2xx = responses.reject { |code| code.start_with?("2") }
  abort_with_output "hey #{phase} received non-2xx responses (#{non_2xx.uniq.join(", ")})", output if non_2xx.any?

  timeouts
end

# Holds SSE streams open during the block and reports how many failed to open.
# Stalled sockets stay connected so their queued requests still contend for
# server capacity; an early close aborts the run.
def with_sse_streams(count)
  sockets = []
  count.times do
    socket = TCPSocket.new("127.0.0.1", H1_PORT)
    sockets << socket
    socket.write("GET /stream HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n")
  end

  pending = sockets.to_h { |socket| [socket, +""] }
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + SSE_OPEN_TIMEOUT_SECONDS
  until pending.empty?
    remaining = deadline - Process.clock_gettime(Process::CLOCK_MONOTONIC)
    break unless remaining.positive?

    ready = IO.select(pending.keys, nil, nil, remaining)
    break unless ready

    ready.first.each do |socket|
      chunk = socket.read_nonblock(4096, exception: false)
      abort "SSE stream closed while opening" unless chunk
      next if chunk == :wait_readable

      response = pending.fetch(socket) << chunk
      next unless response.include?("\r\n\r\n")

      abort_with_output "SSE stream did not open", response unless response.start_with?("HTTP/1.1 200 ")
      pending.delete(socket)
    end
  end

  closed = []
  reader = Thread.new do
    loop do
      IO.select(sockets - closed)[0].each do |socket|
        closed << socket if socket.read_nonblock(4096, exception: false).nil?
      end
    end
  end
  result = yield
  abort "#{closed.length} SSE streams closed during the run" unless closed.empty?

  result.merge(stalled_streams: pending.length)
ensure
  reader&.kill
  reader&.value
  sockets&.each(&:close)
end

def run_h2load(pid, url:, method:)
  method_args = method == :post ? ["-d", POST_BODY_PATH] : []
  warmup = ["h2load", "-c", H2LOAD_CONNECTIONS.to_s, "-m", H2LOAD_STREAMS.to_s, "-D", WARMUP_SECONDS.to_s, *method_args, url]
  warmup_output, warmup_status = Open3.capture2(*warmup)
  abort_with_output "h2load warmup failed", warmup_output unless warmup_status.success?
  check_h2load_clean(warmup_output, "warmup")

  log_file = Tempfile.new(["h2load", ".log"])
  log_file.close
  begin
    measure = ["h2load", "-c", H2LOAD_CONNECTIONS.to_s, "-m", H2LOAD_STREAMS.to_s, "-D", MAIN_SECONDS.to_s, "--log-file", log_file.path, *method_args, url]
    (output, status), usage = measure_server(pid) { Open3.capture2(*measure) }
    abort_with_output "h2load failed", output unless status.success?
    check_h2load_clean(output, "measurement")

    req_s_match = output.match(/finished in [\d.]+s,\s+([\d.]+) req\/s/)
    abort_with_output "Could not parse h2load req/s", output unless req_s_match

    latencies_us = File.readlines(log_file.path).map { |line| line.split[2].to_i }.sort
    abort_with_output "h2load log file empty", output if latencies_us.empty?
    p95_index = (latencies_us.length * 0.95).ceil - 1
    p95_ms = latencies_us[p95_index] / 1000.0

    completed = output.match(/(\d+) succeeded/)[1].to_i
    {
      req_s: req_s_match[1].to_f,
      completed: completed,
      p95_ms: p95_ms,
      cpu_ms_per_request: usage[:cpu_seconds] * 1000 / completed,
      usage: usage,
      warmup_command: warmup,
      measurement_command: measure,
      output: output
    }
  ensure
    log_file.unlink
  end
end

def check_h2load_clean(output, phase)
  requests = output.match(/(\d+) succeeded, (\d+) failed, (\d+) errored, (\d+) timeout/)
  abort_with_output "Could not parse h2load requests summary", output unless requests

  succeeded, failed, errored, timeout = requests.captures.map(&:to_i)
  abort_with_output "h2load #{phase} reported #{failed} failed, #{errored} errored, #{timeout} timeout", output if failed.positive? || errored.positive? || timeout.positive?
  abort_with_output "h2load #{phase} received no successful responses", output if succeeded.zero?

  status_codes = output.match(/status codes: \d+ 2xx, (\d+) 3xx, (\d+) 4xx, (\d+) 5xx/)
  abort_with_output "Could not parse h2load status codes", output unless status_codes

  threes, fours, fives = status_codes.captures.map(&:to_i)
  abort_with_output "h2load #{phase} received non-2xx responses: #{threes} 3xx, #{fours} 4xx, #{fives} 5xx", output if threes.positive? || fours.positive? || fives.positive?
end

def abort_with_output(message, output)
  warn output
  abort message
end

def stats_of(values)
  sorted = values.sort
  median = sorted[sorted.length / 2]
  mean = values.sum / values.length.to_f
  variance = values.sum { |value| (value - mean) ** 2 } / values.length
  stddev = Math.sqrt(variance)
  spread_pct = median.zero? ? 0.0 : ((sorted.last - sorted.first) / 2.0 / median) * 100
  { min: sorted.first, max: sorted.last, median: median, mean: mean, stddev: stddev, spread_pct: spread_pct }
end

def format_req_s(value)
  rounded = (value / 10.0).round * 10
  thousands = rounded / 1000.0
  "#{format("%.2f", thousands)}k"
end

def format_delta(subject, baseline)
  return "-" if baseline.zero?

  delta = (subject - baseline).fdiv(baseline) * 100
  "#{format("%.1f", delta.abs)}% #{delta.negative? ? "lower" : "higher"}"
end

def format_failures(result)
  failures = { "timeout" => result[:timeouts], "stalled stream" => result[:stalled_streams] }.filter_map do |noun, count|
    "#{count} #{noun}#{"s" unless count == 1}" if count.to_i.positive?
  end
  failures.empty? ? "None" : failures.join(", ")
end

def render_markdown_row(cells, widths)
  "| " + cells.map { |key, value| value.ljust(widths[key]) }.join(" | ") + " |"
end

def raptor_cmd(fixture, threads:, max_threads:, protocol:)
  http1_args = protocol != :h2 ? ["--http1-max-keepalive-requests", MAX_KEEPALIVE_REQUESTS.to_s] : []
  bind = if protocol == :h2
    "ssl://0.0.0.0:#{H2_PORT}?cert=#{CERT_PATH}&key=#{KEY_PATH}"
  else
    "tcp://0.0.0.0:#{H1_PORT}"
  end
  [
    "bundle", "exec", "raptor",
    "-b", bind,
    "-w", WORKERS.to_s, "-t", threads.to_s,
    "--max-threads", max_threads.to_s,
    "--no-cpu-affinity",
    "--no-clean-thread-locals",
    "--no-clean-fiber-locals",
    *http1_args,
    "--refork-after", "0",
    fixture
  ]
end

def puma_cmd(fixture, threads:, max_threads:)
  [
    { "PUMA_FIBER_PER_REQUEST" => nil },
    "bundle", "exec", "puma",
    "--no-config",
    "-b", "tcp://0.0.0.0:#{H1_PORT}",
    "-w", WORKERS.to_s, "-t", "#{threads}:#{max_threads}",
    fixture
  ]
end

def falcon_h1_cmd(fixture)
  [
    "bundle", "exec", "falcon", "serve",
    "--bind", "http://0.0.0.0:#{H1_PORT}",
    "--config", fixture,
    "--count", WORKERS.to_s
  ]
end

def falcon_h2_cmd(fixture)
  [
    "bundle", "exec", "falcon", "serve",
    "--bind", "https://0.0.0.0:#{H2_PORT}",
    "--hostname", "localhost",
    "--config", fixture,
    "--count", WORKERS.to_s
  ]
end

cases = []
WORKLOADS.each do |workload, config|
  fixture = config[:fixture]
  protocols = %i[io cpu].include?(workload) ? PROTOCOLS.keys : [:h1_ka]

  protocols.each do |protocol|
    %i[raptor puma falcon].each do |server|
      next if server == :puma && protocol == :h2
      next if workload == :sse_enumerator && server != :raptor

      modes = case
      when server == :falcon then [:fibers]
      when workload == :body then [:scaling]
      when workload == :sse_enumerator then [:fixed]
      when workload == :io && protocol == :h1_ka then %i[fixed scaling fixed16]
      else %i[fixed scaling]
      end

      modes.each do |mode|
        threads, max_threads = MODES.fetch(mode).values_at(:threads, :max_threads)
        command = case server
        when :raptor then raptor_cmd(fixture, threads: threads, max_threads: max_threads, protocol: protocol)
        when :puma then puma_cmd(fixture, threads: threads, max_threads: max_threads)
        when :falcon then protocol == :h2 ? falcon_h2_cmd(fixture) : falcon_h1_cmd(fixture)
        end
        environment = command.first.is_a?(Hash) ? command.shift : {}
        command.unshift(environment.merge("RAPTOR_SSE_BODY" => workload == :sse_enumerator ? "enumerator" : nil))

        cases << {
          label: "#{config[:label]} / #{PROTOCOLS.fetch(protocol)} / #{server.capitalize} / #{MODES.fetch(mode)[:label]}",
          workload: workload,
          protocol: protocol,
          server: server,
          mode: mode,
          command: command,
          samples: []
        }
      end
    end
  end
end

cases.select! { |entry| options[:filter].match?(entry[:label]) } if options[:filter]
abort "No benchmark cases matched" if cases.empty?
budget = cases.length * RUNS_PER_MODE * (WARMUP_SECONDS + MAIN_SECONDS)
log "#{cases.length} cases × #{RUNS_PER_MODE} runs; #{format("%.1f", budget / 60.0)} minutes of timed load, plus startup, SSE setup, and teardown"
if options[:list]
  puts cases.map { |entry| entry[:label] }
  exit
end

require_tool("hey") if cases.any? { |entry| entry[:protocol] != :h2 }
require_tool("h2load") if cases.any? { |entry| entry[:protocol] == :h2 }
require_tool("openssl")
system("bundle", "exec", "rake", "compile", "bpf:compile", exception: true)
generate_cert
write_post_body

output_path = options[:output]
FileUtils.mkdir_p(File.dirname(output_path))
report = {
  started_at: Time.now.utc.iso8601,
  revision: `git rev-parse HEAD`.strip,
  dirty: !`git status --porcelain`.empty?,
  ruby: RUBY_DESCRIPTION,
  kernel: `uname -a`.strip,
  gems: Gem.loaded_specs.transform_values { |spec| spec.version.to_s },
  workers: WORKERS,
  h1_connections: HEY_CONNECTIONS,
  h2_connections: H2LOAD_CONNECTIONS,
  h2_streams: H2LOAD_STREAMS,
  sse_streams: SSE_STREAMS,
  warmup_seconds: WARMUP_SECONDS,
  measurement_seconds: MAIN_SECONDS,
  runs: RUNS_PER_MODE,
  order_seed: ORDER_SEED,
  cases: cases
}
File.write(output_path, JSON.pretty_generate(report))

RUNS_PER_MODE.times do |round|
  cases.shuffle(random: Random.new(ORDER_SEED + round)).each_with_index do |entry, index|
    log "Round #{round + 1}/#{RUNS_PER_MODE}, case #{index + 1}/#{cases.length}: #{entry[:label]}"
    config = WORKLOADS.fetch(entry[:workload])
    streaming = %i[sse sse_enumerator].include?(entry[:workload])
    h2 = entry[:protocol] == :h2
    sample = with_server(entry[:label], entry[:command], [h2 ? H2_PORT : H1_PORT]) do |pid|
      if h2
        run_h2load(pid, url: "https://127.0.0.1:#{H2_PORT}/", method: config[:method])
      else
        measure = proc do
          run_hey(pid, url: "http://127.0.0.1:#{H1_PORT}/", keep_alive: entry[:protocol] == :h1_ka, method: config[:method], allow_timeouts: streaming)
        end
        streaming ? with_sse_streams(SSE_STREAMS, &measure) : measure.call
      end
    end
    entry[:samples] << sample.merge(round: round + 1, position: index + 1)
    File.write(output_path, JSON.pretty_generate(report))
    log "  #{sample[:req_s].round} successful req/s, p95 #{format("%.2f", sample[:p95_ms])} ms, #{format("%.3f", sample[:cpu_ms_per_request])} CPU ms/request; failures: #{format_failures(sample)}"
  end
end

rows = cases.map do |entry|
  samples = entry[:samples]
  summary = %i[req_s p95_ms cpu_ms_per_request].to_h do |key|
    [key, stats_of(samples.map { |sample| sample.fetch(key) })]
  end
  summary[:peak_pss_bytes] = stats_of(samples.map { |sample| sample[:usage][:peak_pss_bytes] })
  entry[:summary] = summary
  failures = %i[timeouts stalled_streams].to_h { |key| [key, samples.sum { |sample| sample.fetch(key, 0) }] }
  {
    workload: entry[:workload] == :sse_enumerator ? :sse : entry[:workload],
    protocol: entry[:protocol],
    server: entry[:workload] == :sse_enumerator ? "Raptor (enum)" : entry[:server].to_s.capitalize,
    mode: MODES.fetch(entry[:mode])[:label],
    summary: summary,
    req_s: format_req_s(summary[:req_s][:median]) + (RUNS_PER_MODE > 1 ? format(" ±%.1f%%", summary[:req_s][:spread_pct]) : ""),
    p95_ms: format("%.2f", summary[:p95_ms][:median]),
    cpu_ms: format("%.3f", summary[:cpu_ms_per_request][:median]),
    pss_mib: format("%.1f", summary[:peak_pss_bytes][:median] / 1024.0**2),
    failures: format_failures(failures)
  }
end

HEADERS = {
  server: "Server",
  mode: "Mode",
  raptor_mode: "Raptor baseline",
  req_s: "req/s",
  vs_raptor_req_s: "vs Raptor req/s",
  p95_ms: "p95 ms",
  vs_raptor_p95: "vs Raptor p95",
  cpu_ms: "CPU ms/req",
  pss_mib: "PSS MiB"
}.freeze

tables = rows.group_by { |row| row.values_at(:workload, :protocol) }.map do |(workload, protocol), group|
  raptor_rows = group.select { |row| row[:server] == "Raptor" }
  comparison_rows = group.flat_map do |row|
    baselines = case row[:server]
    when "Puma" then raptor_rows.select { |raptor| raptor[:mode] == row[:mode] }
    when "Falcon" then raptor_rows
    else []
    end
    baselines = [nil] if baselines.empty?

    baselines.map do |baseline|
      row.merge(
        raptor_mode: baseline ? baseline[:mode] : "-",
        vs_raptor_req_s: baseline ? format_delta(row[:summary][:req_s][:median], baseline[:summary][:req_s][:median]) : "-",
        vs_raptor_p95: baseline ? format_delta(row[:summary][:p95_ms][:median], baseline[:summary][:p95_ms][:median]) : "-"
      )
    end
  end
  widths = HEADERS.to_h do |key, label|
    [key, [label.length, *comparison_rows.map { |row| row.fetch(key).length }].max]
  end
  separator = HEADERS.to_h { |key, _| [key, "-" * widths[key]] }
  lines = [
    "### #{WORKLOADS.fetch(workload)[:label]} over #{PROTOCOLS.fetch(protocol)}",
    "",
    render_markdown_row(HEADERS, widths),
    render_markdown_row(separator, widths)
  ]
  comparison_rows.each { |row| lines << render_markdown_row(row.slice(*HEADERS.keys), widths) }
  group.reject { |row| row[:failures] == "None" }.each do |row|
    lines << "" << "#{row[:server]}, #{row[:mode]} had #{row[:failures]} across all samples."
  end
  lines.join("\n")
end

section = <<~MD
  ## (Micro) Benchmarks

  Raptor #{Raptor::VERSION} vs Puma #{report[:gems].fetch("puma")} vs Falcon #{report[:gems].fetch("falcon")}.
  #{options[:fast] ? "**Smoke run with single short samples, not publication-quality results.**" : "Each case has #{RUNS_PER_MODE} fresh-process samples, interleaved in seeded shuffled rounds."}
  Each sample warms up for #{WARMUP_SECONDS}s and measures for #{MAIN_SECONDS}s. Metrics are independent medians.
  ± is (max − min) / 2 / median, not a confidence interval. Failure counts below each table sum all samples,
  so a failed run cannot disappear in a median. Throughput counts successful ordinary requests only.

  Comparison columns show each server's change from Raptor's median for the baseline mode.
  Higher req/s is better. Lower p95 is better. Falcon's measurements are repeated against each Raptor mode, not rerun.

  **IO** interleaves 5–10 sleeps of 0.5–1.5ms with small JSON renders. **CPU** interleaves 3–5 larger JSON renders
  with 25–50µs sleeps. Both discard the rendered JSON and return a short response. **64 KiB body** sends a prebuilt
  response to isolate response transfer. **SSE (native)** uses Raptor's detached body versus blocking Enumerators.
  **Raptor (enum)** uses the same blocking body as Puma and Falcon, reusing their existing samples for comparison.
  The #{SSE_STREAMS} streams are cluster-wide connections, not guaranteed to be evenly placed. Streams without complete
  headers after #{SSE_OPEN_TIMEOUT_SECONDS}s remain connected and are counted as stalled.

  Fixed (3), Scaling (3–16), and the IO-only Fixed (16) control separate tight concurrency, pool growth,
  and a prestarted larger pool. Falcon uses unbounded fibers and runs once per workload/protocol.
  Raptor request-local cleanup, CPU affinity, and reforking, and Puma's Fiber-per-request mode are disabled.
  Both threaded servers allow #{MAX_KEEPALIVE_REQUESTS} requests per keep-alive connection.

  CPU includes the server master and descendants, including SSE event production, but excludes client CPU and warmup.
  CPU ms/req divides that CPU time by successful ordinary requests. Peak aggregate PSS is sampled every 0.5s,
  proportionally accounting for shared pages instead of counting them fully in every worker.

  #{tables.join("\n\n")}

  > #{RUBY_DESCRIPTION}
  > #{WORKERS} workers, #{HEY_CONNECTIONS} HTTP/1.1 client connections, #{H2LOAD_CONNECTIONS} HTTP/2 connections × #{H2LOAD_STREAMS} streams.

  Run [bin/benchmark](bin/benchmark) to reproduce.
MD

section = section.split("\n\n").map do |paragraph|
  next paragraph if paragraph.start_with?("#", "|", ">")

  paragraph.tr("\n", " ").gsub(/(.{1,120})(?: +|\z)/, "\\1\n").rstrip
end.join("\n\n") + "\n"

report[:finished_at] = Time.now.utc.iso8601
File.write(output_path, JSON.pretty_generate(report))
markdown_path = output_path.sub(/\.json\z/, ".md")
File.write(markdown_path, section)
log "Saved #{output_path} and #{markdown_path}"
puts
puts section

if options[:update_readme]
  readme = File.read(README_PATH)
  abort "Could not find existing (Micro) Benchmarks section in README.md" unless readme.match?(BENCHMARKS_SECTION_PATTERN)

  File.write(README_PATH, readme.sub(BENCHMARKS_SECTION_PATTERN, section))
  log "README.md updated"
end
