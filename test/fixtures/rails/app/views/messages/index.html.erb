<!DOCTYPE html>
<html>
  <head><title>Raptor Rails fixture</title></head>
  <body>
    <main data-process-id="<%= Process.pid %>" data-application-id="<%= Rails.application.object_id %>">
      <h1>Messages</h1>
      <ul>
        <% @messages.each do |message| %>
          <li><%= message.body %></li>
        <% end %>
      </ul>
    </main>
  </body>
</html>
